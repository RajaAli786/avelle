APP_NAME=AVELLE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/avelle
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avelle_store
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
LOG_CHANNEL=single

# EMAIL: local preview until your SMTP account is ready
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-email@example.com
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_ADDRESS=replace-with-your-email@example.com
MAIL_FROM_NAME="Avelle"
# Optional owner inbox for new-order notifications
MAIL_ADMIN_ADDRESS=
